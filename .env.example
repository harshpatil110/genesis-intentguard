# ============================================================================
# INTENTGUARD (PS 01) -- ENVIRONMENT CONFIGURATION
# Copy this file to ./intentguard/backend/.env and fill in real values.
# Never commit .env with real secrets to version control.
# ============================================================================

# --- Application Server ---
APP_NAME=IntentGuard-Hidden-Security-Agent
APP_ENV=development
INTENTGUARD_HOST=0.0.0.0
INTENTGUARD_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Subfolder 1: OpenClaw Base Agent Connection ---
OPENCLAW_GATEWAY_WS_URL=ws://127.0.0.1:18789
OPENCLAW_GATEWAY_HTTP_URL=http://127.0.0.1:18789
OPENCLAW_WORKSPACE_DIR=openclaw/workspace
OPENCLAW_MEMORY_FILE=openclaw/workspace/MEMORY.md

# --- Layer 2: CaMeL Dual-LLM Engine ---
# 1. Privileged Planner (P-LLM - Control Plane: Authority Only, Zero Raw Data Access)
P_LLM_PROVIDER=groq
P_LLM_BASE_URL=https://api.groq.com/openai/v1
P_LLM_MODEL=llama-3.3-70b-versatile
OPENCLAW_PRIMARY_MODEL=groq/llama-3.3-70b-versatile
GROQ_API_KEY=gsk_REPLACE_WITH_YOUR_GROQ_API_KEY

# 2. Quarantined Reader (Q-LLM - Data Plane: Zero Tool Access, Strict JSON Extraction)
# Supports local Ollama (qwen:3b / qwen1.5:3b) with automatic fallback to Groq if Ollama is offline
Q_LLM_PROVIDER=ollama
Q_LLM_BASE_URL=http://localhost:11434/v1
Q_LLM_API_KEY=ollama-local
Q_LLM_MODEL=qwen:3b
Q_LLM_FALLBACK_MODEL=llama-3.1-8b-instant

# --- Layer 2: Memory Quarantine Vault (Redis TTL) ---
REDIS_URL=redis://localhost:6379/0
MEMORY_QUARANTINE_TTL_SECONDS=300

# --- Layer 3: Step-0 HMAC Intent Lock & Resource Budgets ---
HMAC_MASTER_SECRET=genesis2_eva03_ps01_intentguard_hmac_sha256_master_secret_2026
MAX_REQUESTS_PER_MINUTE=30
MAX_TOOL_ITERATIONS_PER_TASK=8
MAX_FILE_UPLOAD_MB=15
MAX_EXECUTION_TIMEOUT_SECONDS=45
ALLOWED_OUTBOUND_DOMAINS=localhost,127.0.0.1,api.groq.com

# --- Supply-Chain Default Party Identifiers ---
DEFAULT_BUYER_ID=buyer-01
DEFAULT_SUPPLIER_ID=supplier-01
DEFAULT_AUDITOR_ID=auditor-01
DEFAULT_POLICY_REFERENCE=policy-v1

# --- Layer 4: Hyperledger Fabric 2.5.16 HTTP Gateway Integration ---
# Never hardcode machine addresses; configure the Fabric FastAPI Gateway URL here.
# Keep BLOCKCHAIN_USE_MOCK=true during standalone app development (Tasks 01-24);
# Switch to false when connecting to the live WSL2 Fabric Gateway API.
BLOCKCHAIN_API_BASE_URL=http://192.168.21.160:8000
BLOCKCHAIN_API_KEY=8339cd137fcf08facdb652c51affce062edfbb68043384f668b008c010927936
BLOCKCHAIN_USE_MOCK=true
BLOCKCHAIN_TIMEOUT_SECONDS=10.0
FABRIC_CHANNEL_NAME=intentguard
FABRIC_CHAINCODE_NAME=intentguard
